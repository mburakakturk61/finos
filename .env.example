# PostgreSQL container credentials.
# Copy this file to .env and fill in real values locally.
# .env is gitignored — never commit real credentials.
POSTGRES_USER=finos
POSTGRES_PASSWORD=changeme
POSTGRES_DB=finos
POSTGRES_PORT=5432

# Connection string used by the backend (SQLAlchemy 2, sync psycopg driver).
# Host is the docker-compose service name "db" when running via docker-compose,
# use "localhost" when running the backend outside of docker-compose.
DATABASE_URL=postgresql+psycopg://finos:changeme@db:5432/finos
